# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=https://emran.work,https://adm1n.emran.work
# Neon Serverless PostgreSQL
DATABASE_URL=postgresql://username:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# JWT Secret for Admin Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=Emran Hossen <dev@emran.work>
ADMIN_EMAIL=dev@emran.work

# ImgBB API Configuration (Free key from https://api.imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key_here

# Cloudflare R2 Object Storage Configuration (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_DOMAIN=https://pub-your_bucket.r2.dev
